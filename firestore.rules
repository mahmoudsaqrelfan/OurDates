rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User data namespace strictly isolated by Firebase Auth UID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // All subcollections (family, children, etc.) strictly restricted to owner UID
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Deny all access to any unhandled paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
